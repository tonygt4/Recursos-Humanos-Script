<VBox alignment="CENTER" prefHeight="351.0" prefWidth="392.0" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
   <children>
      <Pane prefHeight="328.0" prefWidth="359.0">
         <children>
            <Label layoutX="137.0" layoutY="6.0" text="Iniciar sesión" />
            <TextField fx:id="txtUsuario" layoutX="39.0" layoutY="86.0" prefHeight="25.0" prefWidth="278.0" promptText="Usuario" />
            <PasswordField fx:id="txtPassword" layoutX="39.0" layoutY="138.0" onAction="#onIniciarSesion" prefHeight="25.0" prefWidth="278.0" promptText="Contraseña" />
            <Button layoutX="39.0" layoutY="197.0" maxWidth="Infinity" onAction="#onIniciarSesion" prefHeight="25.0" prefWidth="278.0" text="Entrar" />
            <Button layoutX="39.0" layoutY="235.0" maxWidth="Infinity" onAction="#onIrARegistro" prefHeight="25.0" prefWidth="278.0" text="Crear cuenta" />
            <Label layoutX="39.0" layoutY="69.0" text="Usuario" />
            <Label layoutX="45.0" layoutY="121.0" text="Contraseña" />
         </children>
      </Pane>
   </children>
</VBox>
