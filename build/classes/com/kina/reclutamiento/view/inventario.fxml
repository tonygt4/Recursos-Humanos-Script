<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
         <children>
            <Label fx:id="lblUsuario" text="Sesión"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" onAction="#onCerrarSesion"/>
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tablaAspirantes">
         <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="100.0"/>
            <TableColumn fx:id="colApellido" text="Apellido" prefWidth="100.0"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="170.0"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100.0"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="180.0"/>
            <TableColumn fx:id="colEdad" text="Edad" prefWidth="50.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
         </columns>
      </TableView>
   </center>
   <bottom>
      <VBox spacing="10.0">
         <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
         <children>
            <GridPane hgap="10.0" vgap="8.0">
               <columnConstraints>
                  <ColumnConstraints percentWidth="33.0"/>
                  <ColumnConstraints percentWidth="33.0"/>
                  <ColumnConstraints percentWidth="33.0"/>
               </columnConstraints>
               <children>
                  <TextField fx:id="txtNombre" promptText="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                  <TextField fx:id="txtApellido" promptText="Apellido" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                  <TextField fx:id="txtCorreo" promptText="Correo" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                  <TextField fx:id="txtTelefono" promptText="Teléfono" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                  <TextField fx:id="txtDireccion" promptText="Dirección" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                  <TextField fx:id="txtEdad" promptText="Edad" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
               </children>
            </GridPane>
            <HBox spacing="10.0">
               <children>
                  <Button text="Agregar" onAction="#onAgregar"/>
                  <Button text="Actualizar" onAction="#onActualizar"/>
                  <Button text="Eliminar" onAction="#onEliminar"/>
                  <Button text="Limpiar" onAction="#onLimpiar"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
