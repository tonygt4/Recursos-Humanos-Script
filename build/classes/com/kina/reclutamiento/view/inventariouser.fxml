<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
         <children>
            <Label fx:id="lblUsuario" text="Sesión"/>
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tablaAspirantes">
         <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="100.0"/>
            <TableColumn fx:id="colApellido" text="Apellido" prefWidth="100.0"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="170.0"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100.0"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="180.0"/>
            <TableColumn fx:id="colEdad" text="Edad" prefWidth="50.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
         </columns>
      </TableView>
   </center>
</BorderPane>
